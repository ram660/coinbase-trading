# Copy to config/.env and fill in only when you are ready for live trading.
# Paper trading and backtests need none of these.
#
# Create a key at https://www.coinbase.com/settings/api (Coinbase Developer Platform, "Secret API key").
# Give it View + Trade only. Never enable Transfer. Restrict it to your home IP if you can.
COINBASE_API_KEY=organizations/your-org-id/apiKeys/your-key-id
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nREPLACE_ME\n-----END EC PRIVATE KEY-----\n"

# Live orders are refused unless this is set to exactly the phrase below.
CBAGENT_LIVE_CONFIRM=
# CBAGENT_LIVE_CONFIRM=I accept real money risk
